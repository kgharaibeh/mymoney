{
  "name": "@mymoney/api",
  "version": "0.1.0",
  "description": "MyMoney HTTP API (Fastify). Phase 0 runs on in-memory adapters; Prisma adapters for production.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@mymoney/domain": "workspace:*",
    "@mymoney/money-core": "workspace:*",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
