# Copy to .env and fill in. NEVER commit the real .env.

# HTTP
PORT=3000

# Auth — secret used to sign bearer tokens. MUST be set to a long random value
# in production; the server falls back to an insecure dev default if unset.
AUTH_SECRET=

# Database (used by the Prisma adapters, not the in-memory Phase 0 boot)
DATABASE_URL="postgresql://mymoney:mymoney@localhost:5432/mymoney?schema=public"

# Public base URL of the app (used for the Salt Edge return_to redirect).
APP_BASE_URL=https://mymoneyapp.me

# Salt Edge (Account Information API v6) — keep out of source control.
# App-id + Secret are enough for TEST mode; live mode also needs the RSA private
# key (PEM) for request signing.
SALT_EDGE_APP_ID=
SALT_EDGE_SECRET=
# SALT_EDGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
