// MyMoney persistence schema (PostgreSQL).
//
// Money is stored as two columns everywhere: `*AmountMinor` (BigInt, integer
// minor units) + a currency code. There is never a floating-point money column,
// and never a stored "balance" — balances are derived from transactions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  checking
  savings
  credit_card
  cash
  loan
  investment
  asset
}

enum TransactionStatus {
  uncleared
  cleared
  reconciled
}

enum CategoryKind {
  income
  expense
}

enum AggregatorProvider {
  salt_edge
  tink
  plaid
  truelayer
  sandbox
}

enum ConnectionStatus {
  active
  needs_reconsent
  revoked
  error
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accounts     Account[]
  categories   Category[]
  budgets      Budget[]
  connections  AggregatorConnection[]
  rules        CategorizationRule[]
}

model Account {
  id                 String      @id @default(uuid())
  userId             String
  name               String
  type               AccountType
  currency           String      @db.Char(3)
  openingAmountMinor BigInt
  openingDate        DateTime    @db.Date
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  connectionId String?
  externalId   String?
  connection   AggregatorConnection? @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, externalId], name: "conn_ext")
  @@index([userId])
}

model Transaction {
  id                  String            @id @default(uuid())
  accountId           String
  date                DateTime          @db.Date
  amountMinor         BigInt
  currency            String            @db.Char(3)
  payee               String
  categoryId          String?
  status              TransactionStatus @default(uncleared)
  notes               String?
  tags                String[]
  transferGroupId     String?
  externalFingerprint String?
  createdAt           DateTime          @default(now())

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?          @relation(fields: [categoryId], references: [id])
  splits   TransactionSplit[]

  @@unique([accountId, externalFingerprint], name: "dedupe_fingerprint")
  @@index([accountId, date])
  @@index([transferGroupId])
}

model TransactionSplit {
  id            String  @id @default(uuid())
  transactionId String
  categoryId    String
  amountMinor   BigInt
  note          String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
}

model Category {
  id       String       @id @default(uuid())
  userId   String? // null = system default
  parentId String?
  name     String
  kind     CategoryKind

  user     User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]         @relation("CategoryTree")
  txns     Transaction[]
  splits   TransactionSplit[]
  budgets  Budget[]

  @@index([userId])
}

model Budget {
  id          String  @id @default(uuid())
  userId      String
  categoryId  String
  period      String // "YYYY-MM"
  limitMinor  BigInt
  currency    String  @db.Char(3)
  rollover    Boolean @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, period])
}

model FxRate {
  base  String   @db.Char(3)
  quote String   @db.Char(3)
  date  DateTime @db.Date
  rate  Decimal  @db.Decimal(24, 12)

  @@id([base, quote, date])
}

model AggregatorConnection {
  id           String             @id @default(uuid())
  userId       String
  provider     AggregatorProvider
  externalId   String
  status       ConnectionStatus   @default(active)
  lastSyncedAt DateTime?
  createdAt    DateTime           @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

model CategorizationRule {
  id         String   @id @default(uuid())
  userId     String
  match      String
  categoryId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
